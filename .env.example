# ActionLayer Environment Configuration
NODE_ENV=development
PORT=5001

# Database (PostgreSQL running via Docker container "actionlayer-postgres")
DATABASE_URL=postgresql://actionlayer:actionlayer_password@localhost:5432/actionlayer_db

# Google Gemini API (Free tier API key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
DEMO_MODE_ENABLED=true

# RevenueCat Public Client SDK Keys (Optional for local testing, used in mobile build)
EXPO_PUBLIC_RC_APPLE_KEY=appl_your_revenuecat_apple_key
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_your_revenuecat_google_key

# Local Protected File Storage
STORAGE_DIR=./data/uploads
