# ActionLayer Environment Configuration
NODE_ENV=development
PORT=5001

# Database
DATABASE_URL=postgresql://actionlayer:actionlayer_password@localhost:5432/actionlayer_db

# Google Gemini API (Free Tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=mock
DEMO_MODE_ENABLED=true

# Local File Storage
STORAGE_DIR=./data/uploads
