{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "prettier --check \"artifacts/api-server/**/*.{ts,json}\" \"lib/**/*.{ts,json}\"",
    "format": "prettier --write \"artifacts/api-server/**/*.{ts,json}\" \"lib/**/*.{ts,json}\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @workspace/scripts run seed",
    "seed": "pnpm --filter @workspace/scripts run seed",
    "start:api": "pnpm --filter @workspace/api-server run dev",
    "start:mobile": "pnpm --filter @workspace/actionlayer-mobile run dev",
    "dev": "pnpm --filter @workspace/actionlayer-mobile run dev"
  },
  "private": true,
  "dependencies": {
    "@esbuild/darwin-arm64": "^0.28.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js",
      "browser-tabs-lock"
    ]
  }
}
